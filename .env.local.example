# Copy this file to .env.local for local development.
# In Vercel, set these same names under Project Settings -> Environment Variables.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-settings-api

# Optional - defaults to testuser/pass123 if not set
APP_USERNAME=testuser
APP_PASSWORD=pass123
